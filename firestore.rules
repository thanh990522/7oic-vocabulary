rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isTeacher() {
      return signedIn()
        && request.auth.token.email == 'hachithanh2251999@gmail.com';
    }

    match /classes/{classCode} {
      allow read, create, update: if isTeacher();
      allow delete: if false;
    }

    match /students/{studentId} {
      allow read, create, update: if isTeacher();
      allow delete: if false;
    }

    match /progress/{studentId} {
      allow read: if isTeacher()
        || (signedIn() && request.auth.uid == studentId);
      allow create, update: if isTeacher()
        || (signedIn() && request.auth.uid == studentId);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
