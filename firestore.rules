rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isTeacher() {
      return request.auth != null
        && request.auth.token.email == 'hachithanh2251999@gmail.com';
    }

    match /classes/{classCode} {
      allow read, create, update: if isTeacher();
    }

    match /students/{studentId} {
      allow read, create, update: if isTeacher();
    }

    match /progress/{studentId} {
      allow read, create, update: if isTeacher();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
